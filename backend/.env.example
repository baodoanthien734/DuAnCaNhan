# Prisma Database URL
# Hãy cập nhật với database của bạn (PostgreSQL, MySQL, SQLite, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/my_app_db?schema=public"

# SMTP Configuration (Gmail, SendGrid, Ethereal, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM='"Your App" <your-email@gmail.com>'

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Node Environment
NODE_ENV=development
PORT=3001

# ==============================================================================
# GOOGLE OAUTH2 (Login by Google)
# ==============================================================================
# 1. Truy cập https://console.cloud.google.com/
# 2. Tạo Project -> APIs & Services -> Credentials -> Create OAuth client ID
# 3. Copy Client ID và Client Secret dán vào đây:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. URL Callback mà Google sẽ trả về.
# LƯU Ý: Phải là URL của BACKEND (NestJS), không phải URL của Frontend (Next.js)
# Trong môi trường dev: http://localhost:3001/auth/google/callback
# Trong cấu hình Google Console (Authorized redirect URIs) cũng phải thêm y hệt URL này.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback